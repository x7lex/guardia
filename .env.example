# Python reads this root .env automatically; existing process variables take priority.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Gemini key (GEMINI_API_KEY is also supported). Never put it in NEXT_PUBLIC_*.
API_TOKEN=
GEMINI_MODEL=gemini-3.8-flash
# For Next.js backend routing, see the website's .env.example.
# Optional reputation: disabled (default), malwarebazaar, or virustotal.
# These services receive SHA-256 only; no binary upload is implemented.
REPUTATION_PROVIDER=disabled
MALWAREBAZAAR_API_KEY=
VIRUSTOTAL_API_KEY=
# Optional local YARA rules; yara-python is included in requirements.txt.
YARA_RULES_PATH=
