{
  "name": "gaurdia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "desktop:prepare": "npm run build -- --webpack && node electron/prepare-web.mjs",
    "desktop": "npm run desktop:prepare && electron .",
    "desktop:scanner": "node electron/build-scanner.mjs",
    "desktop:pack": "npm run desktop:scanner && npm run desktop:prepare && electron-builder --dir",
    "desktop:dist": "npm run desktop:scanner && npm run desktop:prepare && electron-builder",
    "test:desktop": "node electron/smoke-test.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "main": "electron/main.mjs",
  "description": "Guardia desktop static malware scanner"
}
